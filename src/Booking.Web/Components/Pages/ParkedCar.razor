@* After a parking booking the car drives into its bay (click it to honk).
   After cancelling one it drives out and crashes into the Log out button. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="parked" role="status" aria-label="@(Leaving ? $"You left {Code}" : $"You parked in {Code}")">
    <div class="bay">
        <span class="bay-code">@Code</span>
        <button type="button" class="car @(Leaving ? "leaving" : "arriving")" title="Honk!" aria-label="Honk like a goose"
                @ref="_car" @onclick="HonkAsync">
            <svg viewBox="0 0 120 60" width="120" height="60" aria-hidden="true">
                <rect x="6" y="22" width="108" height="24" rx="10" fill="#e63946" />
                <path d="M30 22 L42 6 H78 L92 22 Z" fill="#e63946" />
                <path d="M36 21 L45 9 H59 V21 Z M63 21 V9 H76 L86 21 Z" fill="#cdeffd" />
                <circle cx="32" cy="46" r="9" fill="#222" /><circle cx="32" cy="46" r="4" fill="#aaa" />
                <circle cx="88" cy="46" r="9" fill="#222" /><circle cx="88" cy="46" r="4" fill="#aaa" />
                <rect x="108" y="28" width="6" height="6" rx="2" fill="#ffd166" />
            </svg>
        </button>
    </div>
    <span class="text-sm text-slate-300">
        @(Leaving ? $"Left {Code}. Mind the Log out button…" : $"Parked in {Code}. Click the car to honk.")
    </span>
    <button type="button" class="ml-auto rounded-lg px-2 py-1 text-slate-400 ring-1 ring-white/15 hover:bg-white/10 hover:text-slate-200" aria-label="Close" @onclick="Close">✕</button>

    @* The wreck, swapped in by the script on impact. *@
    <div hidden @ref="_crashed">
        <svg viewBox="0 0 120 70" width="120" height="70" aria-hidden="true">
            <!-- smoke -->
            <circle cx="26" cy="12" r="7" fill="#9aa0a6" opacity=".7" />
            <circle cx="36" cy="6" r="5" fill="#bdc1c6" opacity=".6" />
            <circle cx="18" cy="5" r="4" fill="#bdc1c6" opacity=".5" />
            <!-- body, crumpled at the front (right) -->
            <path d="M6 34 Q6 30 12 30 H84 L90 26 L96 34 L102 28 L108 36 L104 44 L110 50 L100 54 H12 Q6 54 6 48 Z" fill="#b5232f" />
            <path d="M30 30 L40 16 H70 L80 24 L76 30 Z" fill="#b5232f" />
            <!-- cracked windows -->
            <path d="M35 29 L43 18 H55 V29 Z M59 29 V18 H69 L75 26 L73 29 Z" fill="#cdeffd" />
            <path d="M46 19 L50 25 L47 28 M50 25 L54 22 M64 19 L66 24 L62 28 M66 24 L71 25" stroke="#555" stroke-width="1" fill="none" />
            <!-- dents and scratches -->
            <path d="M20 38 L28 42 L24 46 M60 36 L66 40 L60 44" stroke="#7a1520" stroke-width="2" fill="none" />
            <!-- wheels: back one fine, front one bent and lying flat -->
            <circle cx="30" cy="56" r="9" fill="#222" /><circle cx="30" cy="56" r="4" fill="#aaa" />
            <ellipse cx="88" cy="60" rx="10" ry="6" fill="#222" transform="rotate(-18 88 60)" />
            <!-- broken headlight hanging off -->
            <line x1="106" y1="40" x2="112" y2="52" stroke="#555" stroke-width="1.5" />
            <rect x="109" y="51" width="6" height="5" rx="1" fill="#ffd166" transform="rotate(30 112 53)" />
            <!-- crash burst at the nose -->
            <path d="M112 30 L116 22 L117 31 L120 27 L118 36 L120 42 L114 38 L111 44 L110 36 Z" fill="#ffb703" />
        </svg>
    </div>

    @* The ambulance that comes to take the wreck away. Faces left: it drives in from the right edge. *@
    <div hidden @ref="_ambulance">
        <svg viewBox="0 0 150 80" width="150" height="80" aria-hidden="true">
            <!-- flashing blue lights -->
            <rect x="34" y="6" width="10" height="7" rx="2" fill="#3b82f6">
                <animate attributeName="opacity" values="1;.15;1" dur=".4s" repeatCount="indefinite" />
            </rect>
            <rect x="100" y="6" width="10" height="7" rx="2" fill="#3b82f6">
                <animate attributeName="opacity" values=".15;1;.15" dur=".4s" repeatCount="indefinite" />
            </rect>
            <!-- box and cab -->
            <rect x="30" y="13" width="114" height="47" rx="5" fill="#f8fafc" />
            <path d="M30 24 H14 L4 40 V58 Q4 60 6 60 H30 Z" fill="#f8fafc" />
            <path d="M28 27 H16 L9 39 H28 Z" fill="#bae6fd" />
            <!-- red stripe and cross -->
            <rect x="4" y="46" width="140" height="6" fill="#dc2626" />
            <rect x="78" y="20" width="8" height="22" fill="#dc2626" />
            <rect x="71" y="27" width="22" height="8" fill="#dc2626" />
            <!-- headlight, wheels -->
            <rect x="4" y="42" width="5" height="4" rx="1" fill="#fde047" />
            <circle cx="30" cy="62" r="10" fill="#222" /><circle cx="30" cy="62" r="4" fill="#aaa" />
            <circle cx="118" cy="62" r="10" fill="#222" /><circle cx="118" cy="62" r="4" fill="#aaa" />
        </svg>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    /// <summary>True after a cancel: the car drives out and crashes instead of parking.</summary>
    [Parameter] public bool Leaving { get; set; }

    [Parameter] public EventCallback Closed { get; set; }

    private IJSObjectReference? _module;
    private ElementReference _car;
    private ElementReference _crashed;
    private ElementReference _ambulance;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (Leaving)
            await CallAsync("driveOutAndCrash", _car, _crashed, _ambulance);
        else
            await CallAsync("vroom");
    }

    private Task HonkAsync() => CallAsync("honk");

    private async Task CallAsync(string function, params object[] args)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/ParkedCar.razor.js");
            await _module.InvokeVoidAsync(function, args);
        }
        catch (JSException)
        {
        }
    }

    private Task Close() => Closed.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
