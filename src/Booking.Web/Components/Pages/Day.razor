@page "/"
@* Owned by Person B — tasks B2 and B3. *@
@using System.Globalization
@inject IBookingService Bookings
@inject IOfficeCalendar Calendar
@inject ICurrentUser CurrentUser
@inject IWaitlistService Waitlist
@using Booking.Core.Waitlist

<PageTitle>Book</PageTitle>

<div class="mb-5 flex items-end justify-between gap-4">
    <h1>
        <span class="block text-xs font-normal text-slate-400">@_date.ToString("dddd", CultureInfo.InvariantCulture)</span>
        <span class="block text-3xl font-black tracking-tight">@_date.ToString("d MMM", CultureInfo.InvariantCulture)</span>
    </h1>
    <div class="flex gap-2">
        <button type="button" class="@ArrowClass" aria-label="Previous day"
                disabled="@(!CanGoBack)" @onclick="GoBack">‹</button>
        <button type="button" class="@ArrowClass" aria-label="Next day"
                disabled="@(!CanGoForward)" @onclick="GoForward">›</button>
    </div>
</div>

@if (_day is null)
{
    <p class="text-sm text-slate-400">Loading…</p>
}
else
{
    var deskCount = Count(_day.Desks);
    var hasDesk = ChargerWaitlist.HasBookingOfType(_day, _personId, ResourceType.Desk);
    var hasParking = ChargerWaitlist.HasBookingOfType(_day, _personId, ResourceType.Parking);
    var parkingCount = Count(_day.Parking);

    <div class="mb-5 grid grid-cols-2 gap-3">
        <div class="rounded-xl bg-linear-to-br from-fuchsia-500/20 to-transparent p-3 ring-1 ring-fuchsia-500/30">
            <div class="text-2xl font-bold">@deskCount.Free<span class="text-sm text-slate-400">/@deskCount.Total</span></div>
            <div class="text-xs text-slate-400">desks free</div>
        </div>
        <div class="rounded-xl bg-linear-to-br from-cyan-500/20 to-transparent p-3 ring-1 ring-cyan-500/30">
            <div class="text-2xl font-bold">@parkingCount.Free<span class="text-sm text-slate-400">/@parkingCount.Total</span></div>
            <div class="text-xs text-slate-400">parking free</div>
        </div>
    </div>

    @if (_message is not null)
    {
        <p class="mb-4 rounded-xl bg-rose-500/10 px-4 py-2.5 text-sm text-rose-200 ring-1 ring-rose-500/30" role="alert">@_message</p>
    }

    @if (_car is var (carCode, leaving))
    {
        <ParkedCar @key="(carCode, leaving)" Code="@carCode" Leaving="leaving" Closed="() => _car = null" />
    }

    <div class="grid gap-6 md:grid-cols-2">
        <section class="min-w-0">
            <h2 class="mb-2 text-xs uppercase tracking-wider text-slate-500">Desks</h2>
            @{ var desks = SlotFilter.Apply(_day.Desks, _personId); }
            @if (desks.Count == 0)
            {
                <p class="rounded-xl bg-white/5 px-4 py-3 text-sm text-slate-400">No free desks this day.</p>
            }
            else
            {
                <ul class="divide-y divide-white/5 overflow-hidden rounded-xl bg-white/5">
                    @foreach (var slot in desks)
                    {
                        <SlotRow @key="slot.ResourceId" Slot="slot" Accent="fuchsia" CurrentPersonId="_personId" Busy="_busy" Book="Book" Cancel="Cancel"
                                 CanSwitch="hasDesk" Switch="Switch" />
                    }
                </ul>
            }
        </section>
        <section class="min-w-0">
            <h2 class="mb-2 text-xs uppercase tracking-wider text-slate-500">Parking</h2>
            <div class="mb-2 flex flex-wrap gap-1.5" role="group" aria-label="Filter parking">
                <button type="button" class="@Chip(_location is null)"
                        aria-pressed="@(_location is null ? "true" : "false")" @onclick="() => _location = null">All</button>
                @foreach (var location in ParkingLocations.All)
                {
                    <button type="button" class="@Chip(_location == location)"
                            aria-pressed="@(_location == location ? "true" : "false")" @onclick="() => _location = location">@ParkingLocations.Label(location)</button>
                }
                <button type="button" class="@ChargerChip(_chargerOnly)"
                        aria-pressed="@(_chargerOnly ? "true" : "false")" @onclick="() => _chargerOnly = !_chargerOnly">⚡ Charger</button>
            </div>
            @{ var parking = SlotFilter.Apply(_day.Parking, _personId, _location, _chargerOnly); }
            @if (parking.Count == 0)
            {
                <p class="rounded-xl bg-white/5 px-4 py-3 text-sm text-slate-400">No free spots match this filter.</p>
            }
            else
            {
                <ul class="divide-y divide-white/5 overflow-hidden rounded-xl bg-white/5">
                    @foreach (var slot in parking)
                    {
                        <SlotRow @key="slot.ResourceId" Slot="slot" Accent="cyan" CurrentPersonId="_personId" Busy="_busy" Book="Book" Cancel="Cancel"
                                 CanSwitch="hasParking" Switch="Switch" />
                    }
                </ul>
            }
            @switch (ChargerWaitlist.For(_day, _personId, _chargerOnly, _onWaitlist, _hasEmail))
            {
                case ChargerWaitlistLine.CanJoin:
                    <div class="mt-3 flex flex-wrap items-center gap-3 rounded-xl bg-amber-400/10 px-4 py-3 text-sm text-amber-100 ring-1 ring-amber-400/30">
                        <span class="flex-1">All charger spots are taken on @DateText.</span>
                        <button type="button" class="@WaitlistButton" disabled="@_busy" @onclick="JoinWaitlist">Notify me when one frees up</button>
                    </div>
                    break;
                case ChargerWaitlistLine.OnList:
                    <div class="mt-3 flex flex-wrap items-center gap-3 rounded-xl bg-amber-400/10 px-4 py-3 text-sm text-amber-100 ring-1 ring-amber-400/30">
                        <span class="flex-1">You're on the waitlist for a charger spot on @DateText.</span>
                        <button type="button" class="@LeaveButton" disabled="@_busy" @onclick="LeaveWaitlist">Leave</button>
                    </div>
                    break;
                case ChargerWaitlistLine.NeedsEmail:
                    <p class="mt-3 rounded-xl bg-white/5 px-4 py-3 text-sm text-slate-400">@WaitlistMessages.For(WaitlistError.NoEmail)</p>
                    break;
            }
        </section>
    </div>

    <p class="mt-6 text-sm text-slate-400">
        @if (_day.PeopleInOffice.Count == 0)
        {
            @:Nobody booked yet.
        }
        else
        {
            @:In the office: @string.Join(", ", _day.PeopleInOffice)
        }
    </p>
}

@code {
    private const string ArrowClass =
        "grid h-9 w-9 place-items-center rounded-full bg-white/10 text-lg hover:bg-white/15 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-white/10";

    private static string Chip(bool on) => on
        ? "rounded-full bg-cyan-500 px-3 py-1 text-xs font-semibold text-slate-950"
        : "rounded-full bg-white/5 px-3 py-1 text-xs text-slate-300 ring-1 ring-white/10 hover:bg-white/10";

    private static string ChargerChip(bool on) => on
        ? "rounded-full bg-amber-400 px-3 py-1 text-xs font-semibold text-slate-950"
        : "rounded-full bg-white/5 px-3 py-1 text-xs text-amber-300 ring-1 ring-amber-400/30 hover:bg-white/10";

    private const string WaitlistButton =
        "shrink-0 rounded-lg bg-amber-400 px-3 py-1 text-xs font-semibold text-slate-950 enabled:hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-40";

    private const string LeaveButton =
        "shrink-0 rounded-lg px-3 py-1 text-xs ring-1 ring-white/20 enabled:hover:bg-white/10 disabled:cursor-not-allowed disabled:opacity-40";

    private string DateText => _date.ToString("ddd d MMM", CultureInfo.InvariantCulture);

    /// <summary>Free and total for the counters: all of the day's slots, not just the filtered list.</summary>
    private static (int Free, int Total) Count(IReadOnlyList<ResourceSlot> slots) =>
        (slots.Count(s => s.BookingId is null), slots.Count);

    private DateOnly _date;
    private DayOverview? _day;
    private int? _personId;
    private string? _message;   // result of the last Book/Cancel; cleared on the next action or day change
    private bool _busy;         // a Book/Cancel call is running — buttons are disabled
    private ParkingLocation? _location;   // parking filter; null = all locations
    private bool _chargerOnly;           // parking filter: only spots with an EV charger
    private (string Code, bool Leaving)? _car;   // last parking Book/Cancel: car drives in, or out and crashes
    private bool _onWaitlist;            // on the charger waitlist for _date
    private bool _hasEmail;              // the waitlist needs an email address (from Keycloak)

    private bool CanGoBack => Calendar.PreviousWeekday(_date) >= Calendar.FirstBookableDay;

    private bool CanGoForward => Calendar.NextWeekday(_date) <= Calendar.LastBookableDay;

    protected override async Task OnInitializedAsync()
    {
        _date = Calendar.FirstBookableDay;
        _personId = await CurrentUser.GetPersonIdAsync();
        await LoadDay();
    }

    private async Task LoadDay()
    {
        _day = await Bookings.GetDayAsync(_date);
        if (_personId is int personId)
        {
            _onWaitlist = await Waitlist.IsOnWaitlistAsync(personId, _date);
            _hasEmail = await Waitlist.HasEmailAsync(personId);
        }
    }

    private async Task GoBack()
    {
        if (!CanGoBack) return;
        _message = null;
        _car = null;
        _date = Calendar.PreviousWeekday(_date);
        await LoadDay();
    }

    private async Task GoForward()
    {
        if (!CanGoForward) return;
        _message = null;
        _car = null;
        _date = Calendar.NextWeekday(_date);
        await LoadDay();
    }

    private Task Book(ResourceSlot slot) =>
        _personId is int personId
            ? Run(slot, () => Bookings.BookAsync(personId, slot.ResourceId, _date))
            : Task.CompletedTask;

    private Task Switch(ResourceSlot slot) =>
        _personId is int personId
            ? Run(slot, () => Bookings.SwitchAsync(personId, slot.ResourceId, _date))
            : Task.CompletedTask;

    private Task JoinWaitlist() => RunWaitlist(async personId =>
    {
        var result = await Waitlist.JoinAsync(personId, _date);
        return result.Error is WaitlistError error ? WaitlistMessages.For(error) : null;
    });

    private Task LeaveWaitlist() => RunWaitlist(async personId =>
    {
        await Waitlist.LeaveAsync(personId, _date);
        return null;
    });

    /// <summary>Runs one waitlist action like <see cref="Run"/>: one at a time, shows its error, always reloads.</summary>
    private async Task RunWaitlist(Func<int, Task<string?>> action)
    {
        if (_busy || _personId is not int personId) return;
        _busy = true;
        _message = null;
        try
        {
            _message = await action(personId);
            await LoadDay();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Cancel(ResourceSlot slot) =>
        _personId is int personId && slot.BookingId is int bookingId
            ? Run(slot, () => Bookings.CancelAsync(personId, bookingId))
            : Task.CompletedTask;

    /// <summary>Runs one Book/Cancel, shows its error (if any) and always reloads the day, success or not.</summary>
    private async Task Run(ResourceSlot slot, Func<Task<BookingResult>> action)
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        _car = null;
        try
        {
            var result = await action();
            if (result.Error is BookingError error)
                _message = BookingMessages.For(error, slot);
            else if (slot.Type == ResourceType.Parking)
                _car = (slot.Code, Leaving: slot.BookingId is not null);   // had a booking = this was a cancel
            await LoadDay();
        }
        finally
        {
            _busy = false;
        }
    }
}
