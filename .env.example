# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# For `dotnet run` use user-secrets instead, e.g.:
#   dotnet user-secrets set "Keycloak:ClientSecret" "<secret>" --project src/Booking.Web
#   (same for Keycloak:Authority and Keycloak:ClientId)

# Realm URL, e.g. https://sso.example.org/realms/<realm>
KEYCLOAK_AUTHORITY=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# The Keycloak client (confidential, standard flow) must allow:
#   Valid redirect URIs:
#     http://localhost:8080/signin-oidc        (docker compose)
#     http://localhost:5017/signin-oidc        (dotnet run)
#     https://<prod-host>/signin-oidc
#   Valid post logout redirect URIs:
#     http://localhost:8080/signout-callback-oidc
#     http://localhost:5017/signout-callback-oidc
#     https://<prod-host>/signout-callback-oidc
#
# Production runs behind an HTTPS reverse proxy: set ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# on the app container there, or Keycloak gets an http:// redirect address and rejects the login.
