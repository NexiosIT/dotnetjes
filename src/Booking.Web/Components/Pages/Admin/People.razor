@page "/admin/people"
@* Owned by Person C — task C3. Read-only since Keycloak login: only Active can change. *@
@inject IAdminService Admin

<PageTitle>Admin · People</PageTitle>

<h1>People</h1>

<AdminTabs />

<p class="text-muted">People appear here after their first login. Names and emails come from Keycloak.</p>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (people is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Name</th><th>Email</th><th>Active</th></tr>
        </thead>
        <tbody>
            @foreach (var p in people)
            {
                <tr @key="p.Id" class="@(p.IsActive ? null : "text-muted")">
                    <td>@p.Name</td>
                    <td>@p.Email</td>
                    <td>
                        <input type="checkbox" class="form-check-input" checked="@p.IsActive"
                               aria-label="Active" @onchange="() => ToggleActiveAsync(p)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<Person>? people;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => people = await Admin.GetPeopleAsync();

    private Task ToggleActiveAsync(Person p) =>
        RunAsync(() => Admin.SetPersonActiveAsync(p.Id, !p.IsActive));

    /// <summary>Runs an admin change, shows a validation message if it was refused, and reloads the table either way.</summary>
    private async Task RunAsync(Func<Task> change)
    {
        try
        {
            await change();
            error = null;
        }
        catch (AdminValidationException ex)
        {
            error = ex.Message;
        }
        await LoadAsync();
    }
}
