@using Booking.Web.Auth

<AuthorizeView>
    <div class="d-flex align-items-center gap-2">
        <span>@KeycloakClaims.Read(context.User)?.Name</span>
        <form method="post" action="logout">
            <AntiforgeryToken />
            @* The id is the target of the "car crashes into Log out" animation after cancelling a parking spot. *@
            <button type="submit" id="logout-button" class="btn btn-outline-secondary btn-sm">Log out</button>
        </form>
    </div>
</AuthorizeView>
