@* Owned by Person C. Shared header of the admin pages: title, "Send today's summary now" and the tabs. *@
@using Booking.Application.Notifications
@inject DailySummarySender SummarySender
@inject ILogger<AdminTabs> Logger

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <h1>
        <span class="block text-xs font-normal text-slate-400">Admin</span>
        <span class="block text-3xl font-black tracking-tight">@Title</span>
    </h1>
    <div class="flex flex-wrap items-center gap-3">
        @if (summaryMessage is not null)
        {
            <span class="text-sm @(summaryOk ? "text-emerald-300" : "text-rose-300")" role="status">@summaryMessage</span>
        }
        <button class="rounded-lg bg-linear-to-r from-fuchsia-500 to-cyan-500 px-4 py-2 text-sm font-semibold hover:brightness-110 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-fuchsia-400 disabled:cursor-not-allowed disabled:opacity-40"
                disabled="@sending" @onclick="SendSummaryAsync">
            @if (sending) { <text>Sending…</text> } else { <span aria-hidden="true">✉</span> <text>Send today's summary now</text> }
        </button>
    </div>
</div>

<nav class="mb-6 inline-flex max-w-full flex-wrap rounded-xl bg-white/5 p-1 text-sm">
    <NavLink href="admin/resources" class="@TabClass" ActiveClass="bg-fuchsia-500 font-semibold text-white">Desks & parking</NavLink>
    <NavLink href="admin/people" class="@TabClass" ActiveClass="bg-fuchsia-500 font-semibold text-white">People</NavLink>
    <NavLink href="admin/day" class="@TabClass" ActiveClass="bg-fuchsia-500 font-semibold text-white">Day overview</NavLink>
</nav>

@code {
    private const string TabClass = "rounded-lg px-4 py-1.5 text-slate-400 hover:text-slate-200";

    /// <summary>The page name shown under "Admin".</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    private bool sending;
    private string? summaryMessage;
    private bool summaryOk;

    private async Task SendSummaryAsync()
    {
        if (sending)
        {
            return;
        }
        sending = true;
        summaryMessage = null;
        try
        {
            var result = await SummarySender.SendTodayAsync(CancellationToken.None);
            summaryOk = result.Failed == 0;
            summaryMessage = summaryOk
                ? $"Sent {result.Sent} emails."
                : $"Sent {result.Sent}, failed {result.Failed} — check the logs.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sending the daily summary from the admin page failed");
            summaryOk = false;
            summaryMessage = "Couldn't send the summary — check the logs.";
        }
        finally
        {
            sending = false;
        }
    }
}
