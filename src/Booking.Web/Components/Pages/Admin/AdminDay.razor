@page "/admin/day"
@* Admin view of a whole day: every desk and parking spot, with who booked it. Read-only. *@
@using System.Globalization
@inject IBookingService Bookings
@inject IOfficeCalendar Calendar

<PageTitle>Admin · Day overview</PageTitle>

<AdminTabs Title="Day overview" />

<div class="mb-5 flex items-end justify-between gap-4">
    <h2>
        <span class="block text-xs font-normal text-slate-400">@_date.ToString("dddd", CultureInfo.InvariantCulture)</span>
        <span class="block text-2xl font-black tracking-tight">@_date.ToString("d MMM", CultureInfo.InvariantCulture)</span>
    </h2>
    <div class="flex items-center gap-2">
        <button type="button" class="@ArrowClass" aria-label="Previous day" @onclick="GoBack">‹</button>
        <button type="button" class="@ArrowClass" aria-label="Next day" @onclick="GoForward">›</button>
        <button type="button" class="rounded-lg px-3 py-1.5 text-sm text-fuchsia-300 hover:bg-white/5" @onclick="GoToday">Today</button>
    </div>
</div>

@if (_day is null)
{
    <p class="text-sm text-slate-400">Loading…</p>
}
else
{
    <div class="grid gap-6 md:grid-cols-2">
        <section class="min-w-0">
            <h3 class="mb-2 text-xs uppercase tracking-wider text-slate-500">Desks · @Booked(_day.Desks) of @_day.Desks.Count booked</h3>
            <ul class="divide-y divide-white/5 overflow-hidden rounded-xl bg-white/5">
                @foreach (var slot in _day.Desks)
                {
                    <SlotRow @key="slot.ResourceId" Slot="slot" Accent="fuchsia" ReadOnly="true" />
                }
            </ul>
        </section>
        <section class="min-w-0">
            <h3 class="mb-2 text-xs uppercase tracking-wider text-slate-500">Parking · @Booked(_day.Parking) of @_day.Parking.Count booked</h3>
            <ul class="divide-y divide-white/5 overflow-hidden rounded-xl bg-white/5">
                @foreach (var slot in _day.Parking)
                {
                    <SlotRow @key="slot.ResourceId" Slot="slot" Accent="cyan" ReadOnly="true" />
                }
            </ul>
        </section>
    </div>

    <p class="mt-6 text-sm text-slate-400">
        @(_day.PeopleInOffice.Count == 0 ? "Nobody booked." : $"In the office: {string.Join(", ", _day.PeopleInOffice)}")
    </p>
}

@code {
    private const string ArrowClass = "grid h-9 w-9 place-items-center rounded-full bg-white/10 text-lg hover:bg-white/15";

    private DateOnly _date;
    private DayOverview? _day;

    protected override async Task OnInitializedAsync()
    {
        _date = Calendar.FirstBookableDay;
        await LoadDay();
    }

    private static int Booked(IReadOnlyList<ResourceSlot> slots) => slots.Count(s => s.BookingId is not null);

    private async Task LoadDay() => _day = await Bookings.GetDayAsync(_date);

    // Admins can also look back at past days, so no range limit here.
    private async Task GoBack()
    {
        _date = Calendar.PreviousWeekday(_date);
        await LoadDay();
    }

    private async Task GoForward()
    {
        _date = Calendar.NextWeekday(_date);
        await LoadDay();
    }

    private async Task GoToday()
    {
        _date = Calendar.FirstBookableDay;
        await LoadDay();
    }
}
