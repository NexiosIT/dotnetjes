@page "/admin/day"
@* Admin view of a whole day: every desk and parking spot, with who booked it. Read-only. *@
@using System.Globalization
@inject IBookingService Bookings
@inject IOfficeCalendar Calendar

<PageTitle>Admin · Day overview</PageTitle>

<h1>Day overview</h1>

<AdminTabs />

<div class="d-flex align-items-center gap-2 mb-3">
    <h2 class="h4 mb-0 me-2">@_date.ToString("ddd d MMM", CultureInfo.InvariantCulture)</h2>
    <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Previous day" @onclick="GoBack">◀</button>
    <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Next day" @onclick="GoForward">▶</button>
    <button type="button" class="btn btn-link btn-sm" @onclick="GoToday">Today</button>
</div>

@if (_day is null)
{
    <p>Loading…</p>
}
else
{
    <div class="row g-4">
        <div class="col-md-6">
            <h3 class="h6 text-uppercase">Desks · @Booked(_day.Desks) of @_day.Desks.Count booked</h3>
            <ul class="list-group">
                @foreach (var slot in _day.Desks)
                {
                    <SlotRow @key="slot.ResourceId" Slot="slot" ReadOnly="true" />
                }
            </ul>
        </div>
        <div class="col-md-6">
            <h3 class="h6 text-uppercase">Parking · @Booked(_day.Parking) of @_day.Parking.Count booked</h3>
            <ul class="list-group">
                @foreach (var slot in _day.Parking)
                {
                    <SlotRow @key="slot.ResourceId" Slot="slot" ReadOnly="true" />
                }
            </ul>
        </div>
    </div>

    <p class="mt-4">
        @(_day.PeopleInOffice.Count == 0 ? "Nobody booked." : $"In the office: {string.Join(", ", _day.PeopleInOffice)}")
    </p>
}

@code {
    private DateOnly _date;
    private DayOverview? _day;

    protected override async Task OnInitializedAsync()
    {
        _date = Calendar.FirstBookableDay;
        await LoadDay();
    }

    private static int Booked(IReadOnlyList<ResourceSlot> slots) => slots.Count(s => s.BookingId is not null);

    private async Task LoadDay() => _day = await Bookings.GetDayAsync(_date);

    // Admins can also look back at past days, so no range limit here.
    private async Task GoBack()
    {
        _date = Calendar.PreviousWeekday(_date);
        await LoadDay();
    }

    private async Task GoForward()
    {
        _date = Calendar.NextWeekday(_date);
        await LoadDay();
    }

    private async Task GoToday()
    {
        _date = Calendar.FirstBookableDay;
        await LoadDay();
    }
}
