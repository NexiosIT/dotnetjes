@page "/admin/people"
@* Owned by Person C — task C3. Read-only since Keycloak login: only Active can change. *@
@using static Booking.Web.Components.Pages.Admin.AdminStyles
@inject IAdminService Admin

<PageTitle>Admin · People</PageTitle>

<AdminTabs Title="People" />

<p class="mb-4 text-sm text-slate-400">People appear here after their first login. Names and emails come from Keycloak.</p>

@if (error is not null)
{
    <div class="@Error" role="alert">@error</div>
}

@if (people is null)
{
    <p class="text-sm text-slate-400">Loading…</p>
}
else
{
    <div class="@TableWrap">
        <table class="@Table">
            <thead class="@Head">
                <tr><th class="@Th">Name</th><th class="@Th">Email</th><th class="@Th">Active</th></tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                @foreach (var p in people)
                {
                    <tr @key="p.Id" class="@(p.IsActive ? null : "text-slate-500")">
                        <td class="@Td min-w-28 max-w-xs wrap-anywhere font-semibold">@p.Name</td>
                        <td class="@Td @(p.IsActive ? "text-slate-300" : null) min-w-56 max-w-xs break-all">@p.Email</td>
                        <td class="@Td">
                            <input type="checkbox" class="@Switch" checked="@p.IsActive"
                                   aria-label="Active" @onchange="() => ToggleActiveAsync(p)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Person>? people;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => people = await Admin.GetPeopleAsync();

    private Task ToggleActiveAsync(Person p) =>
        RunAsync(() => Admin.SetPersonActiveAsync(p.Id, !p.IsActive));

    /// <summary>Runs an admin change, shows a validation message if it was refused, and reloads the table either way.</summary>
    private async Task RunAsync(Func<Task> change)
    {
        try
        {
            await change();
            error = null;
        }
        catch (AdminValidationException ex)
        {
            error = ex.Message;
        }
        await LoadAsync();
    }
}
