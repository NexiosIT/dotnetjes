@page "/admin/resources"
@* Owned by Person C — task C2. *@
@using static Booking.Web.Components.Pages.Admin.AdminStyles
@inject IAdminService Admin

<PageTitle>Admin · Desks & parking</PageTitle>

<AdminTabs Title="Desks & parking" />

<form class="@Panel" @onsubmit="AddAsync">
    <label class="@Label" for="new-code">
        <span class="@LabelText">Code</span>
        <input id="new-code" class="@Input w-24" @bind="newCode" placeholder="D9" />
    </label>
    <label class="@Label" for="new-name">
        <span class="@LabelText">Name</span>
        <input id="new-name" class="@Input w-48" @bind="newName" placeholder="Desk 9" />
    </label>
    <label class="@Label" for="new-type">
        <span class="@LabelText">Type</span>
        <select id="new-type" class="@Input" @bind="newType">
            <option value="@ResourceType.Desk">Desk</option>
            <option value="@ResourceType.Parking">Parking</option>
        </select>
    </label>
    <button type="submit" class="@Primary">Add</button>
</form>

@if (error is not null)
{
    <div class="@Error" role="alert">@error</div>
}

@if (resources is null)
{
    <p class="text-sm text-slate-400">Loading…</p>
}
else
{
    <div class="@TableWrap">
        <table class="@Table">
            <thead class="@Head">
                <tr>
                    <th class="@Th">Code</th><th class="@Th">Name</th><th class="@Th">Type</th><th class="@Th">Location</th>
                    <th class="@Th">Charger</th><th class="@Th">Active</th><th class="@Th"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                @foreach (var r in resources)
                {
                    <tr @key="r.Id" class="@(editingId == r.Id ? "bg-fuchsia-500/10" : r.IsActive ? null : "text-slate-500")">
                        @if (editingId == r.Id)
                        {
                            <td class="px-4 py-2"><input class="@CellInput" @bind="editCode" aria-label="Code" /></td>
                            <td class="px-4 py-2"><input class="@CellInput" @bind="editName" aria-label="Name" /></td>
                        }
                        else
                        {
                            <td class="@Td font-bold">@r.Code</td>
                            <td class="@Td @(r.IsActive ? "text-slate-300" : null) min-w-32 max-w-xs wrap-anywhere">@r.Name</td>
                        }
                        <td class="@Td">
                            <span class="rounded-full px-2 text-xs @(r.Type == ResourceType.Desk ? "bg-fuchsia-500/15 text-fuchsia-300" : "bg-cyan-500/15 text-cyan-300")">@r.Type</span>
                        </td>
                        @if (r.Type == ResourceType.Parking)
                        {
                            <td class="px-4 py-2">
                                <select class="@CellSelect" aria-label="Location"
                                        value="@(r.Location?.ToString() ?? "")" @onchange="e => SetLocationAsync(r, e.Value as string)">
                                    <option value="">— not set —</option>
                                    @foreach (var location in ParkingLocations.All)
                                    {
                                        <option value="@location">@ParkingLocations.Label(location)</option>
                                    }
                                </select>
                            </td>
                            <td class="@Td">
                                <input type="checkbox" class="@Switch" checked="@r.HasCharger"
                                       aria-label="EV charger" @onchange="() => ToggleChargerAsync(r)" />
                            </td>
                        }
                        else
                        {
                            <td class="@Td text-slate-600">—</td>
                            <td class="@Td text-slate-600">—</td>
                        }
                        <td class="@Td">
                            <input type="checkbox" class="@Switch" checked="@r.IsActive"
                                   aria-label="Active" @onchange="() => ToggleActiveAsync(r)" />
                        </td>
                        <td class="@Td whitespace-nowrap text-right">
                            @if (editingId == r.Id)
                            {
                                <button class="@SmallPrimary" @onclick="() => SaveEditAsync(r)">Save</button>
                                <button class="@SmallLink" @onclick="CancelEdit">Cancel</button>
                            }
                            else
                            {
                                <button class="@SmallSecondary" @onclick="() => StartEdit(r)">Edit</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Resource>? resources;
    private string? error;

    private string newCode = "";
    private string newName = "";
    private ResourceType newType = ResourceType.Desk;

    private int? editingId;
    private string editCode = "";
    private string editName = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => resources = await Admin.GetResourcesAsync();

    private Task AddAsync() => RunAsync(async () =>
    {
        await Admin.AddResourceAsync(newCode, newName, newType);
        newCode = "";
        newName = "";
    });

    private void StartEdit(Resource r)
    {
        editingId = r.Id;
        editCode = r.Code;
        editName = r.Name;
        error = null;
    }

    private void CancelEdit() => editingId = null;

    private Task SaveEditAsync(Resource r) => RunAsync(async () =>
    {
        await Admin.UpdateResourceAsync(r.Id, editCode, editName, r.IsActive);
        editingId = null;
    });

    private Task ToggleActiveAsync(Resource r) =>
        RunAsync(() => Admin.UpdateResourceAsync(r.Id, r.Code, r.Name, !r.IsActive));

    private Task SetLocationAsync(Resource r, string? value) =>
        RunAsync(() => Admin.SetParkingDetailsAsync(
            r.Id, Enum.TryParse<ParkingLocation>(value, out var location) ? location : null, r.HasCharger));

    private Task ToggleChargerAsync(Resource r) =>
        RunAsync(() => Admin.SetParkingDetailsAsync(r.Id, r.Location, !r.HasCharger));

    /// <summary>Runs an admin change, shows a validation message if it was refused, and reloads the table either way.</summary>
    private async Task RunAsync(Func<Task> change)
    {
        try
        {
            await change();
            error = null;
        }
        catch (DomainValidationException ex)
        {
            error = ex.Message;
        }
        await LoadAsync();
    }
}
