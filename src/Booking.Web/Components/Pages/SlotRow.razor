@* One desk or parking spot in the day view (and, read-only, in the admin day overview). Owned by Person B — tasks B2 and B3. *@

@if (Slot.BookingId is null)
{
    <li class="@RowBase">
        <strong class="@CodeClass">@Slot.Code</strong>
        @NameAndBadges
        <span class="shrink-0 rounded-full bg-emerald-400/15 px-2 text-xs text-emerald-300">free</span>
        @if (!ReadOnly)
        {
            <button type="button" class="@BookButton" disabled="@(CurrentPersonId is null || Busy)"
                    @onclick="OnBook">Book</button>
        }
    </li>
}
else if (!ReadOnly && Slot.BookedByPersonId == CurrentPersonId)
{
    <li class="@RowBase @(IsCyan ? "bg-cyan-500/10" : "bg-fuchsia-500/10")">
        <strong class="@CodeClass">@Slot.Code</strong>
        @NameAndBadges
        <span class="shrink-0 text-xs font-semibold @(IsCyan ? "text-cyan-300" : "text-fuchsia-300")">You</span>
        <button type="button" class="@CancelButton" disabled="@Busy" @onclick="OnCancel">Cancel</button>
    </li>
}
else
{
    <li class="@RowBase text-slate-500">
        <strong class="@CodeClass text-slate-400">@Slot.Code</strong>
        @NameAndBadges
        <span class="max-w-[40%] truncate text-xs">taken by @Slot.BookedByName</span>
    </li>
}

@code {
    private const string RowBase = "flex items-center gap-3 px-3 py-2 text-sm";
    // Grows with longer codes (up to 35% of the row) so a code never runs into the name.
    private const string CodeClass = "min-w-8 max-w-[35%] shrink-0 truncate";
    private const string Disabled = " disabled:cursor-not-allowed disabled:opacity-40";
    private const string CancelButton = "shrink-0 rounded-lg px-3 py-1 text-xs ring-1 ring-white/20 hover:bg-white/10" + Disabled;

    [Parameter, EditorRequired] public ResourceSlot Slot { get; set; } = default!;

    /// <summary>"fuchsia" for desks, "cyan" for parking.</summary>
    [Parameter] public string Accent { get; set; } = "fuchsia";

    /// <summary>The person using this browser, or null when nobody has been picked.</summary>
    [Parameter] public int? CurrentPersonId { get; set; }

    /// <summary>True while a Book/Cancel call is running, so the buttons can't be double-clicked.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Admin overview: show who booked what, no Book/Cancel buttons.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<ResourceSlot> Book { get; set; }

    [Parameter] public EventCallback<ResourceSlot> Cancel { get; set; }

    private bool IsCyan => Accent == "cyan";

    // Full class names (not built from Accent) so the Tailwind build can find them.
    private string BookButton => (IsCyan
        ? "shrink-0 rounded-lg bg-cyan-500 px-3 py-1 text-xs font-semibold text-slate-950 hover:bg-cyan-400"
        : "shrink-0 rounded-lg bg-fuchsia-500 px-3 py-1 text-xs font-semibold hover:bg-fuchsia-400") + Disabled;

    /// <summary>The name (truncated when long) followed by the location and charger badges, which always stay visible.</summary>
    private RenderFragment NameAndBadges => __builder =>
    {
        <span class="flex min-w-0 flex-1 items-center gap-1.5">
            <span class="truncate text-slate-400">@Slot.Name</span>
            @if (Slot.Location is ParkingLocation location)
            {
                <span class="shrink-0 rounded-full bg-white/10 px-2 text-xs text-slate-300">@ParkingLocations.Label(location)</span>
            }
            @if (Slot.HasCharger)
            {
                <span class="shrink-0 rounded-full bg-amber-400/15 px-2 text-xs text-amber-300" title="EV charger">⚡ Charger</span>
            }
        </span>
    };

    private Task OnBook() => Book.InvokeAsync(Slot);

    private Task OnCancel() => Cancel.InvokeAsync(Slot);
}
